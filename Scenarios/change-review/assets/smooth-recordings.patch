@@ -0,0 +1,51 @@
+import CoreGraphics
+import Foundation
+
+/// One rendered frame of a noodlet, taken while the page runs on a
+/// virtual clock.
+///
+/// The page reports the frame number and the virtual time it rendered at,
+/// so the recorder can check that it is filming the frame it asked for and
+/// not a stale one left over from before the clock moved.
+public struct NoodletSnapshot: @unchecked Sendable {
+    public let image: CGImage
+    public let frame: RenderedFrame
+
+    public init(image: CGImage, frame: RenderedFrame) {
+        self.image = image
+        self.frame = frame
+    }
+
+    public var pixelWidth: Int { image.width }
+    public var pixelHeight: Int { image.height }
+}
+
+/// What the page reports after it has drawn a frame on the virtual clock.
+public struct RenderedFrame: Codable, Equatable, Sendable {
+    /// Number of the frame, counted from zero when virtual time started.
+    public var index: Int
+    /// Virtual time of the frame in milliseconds since virtual time started.
+    public var time: Double
+    /// Timers and animation frame callbacks that ran for this frame.
+    public var callbacks: Int
+    /// CSS and Web Animations that were held at this frame.
+    public var pausedAnimations: Int
+
+    public init(index: Int, time: Double, callbacks: Int = 0, pausedAnimations: Int = 0) {
+        self.index = index
+        self.time = time
+        self.callbacks = callbacks
+        self.pausedAnimations = pausedAnimations
+    }
+
+    /// Seconds of virtual time, as used for movie presentation times.
+    public var seconds: Double {
+        time / 1000
+    }
+
+    /// Whether this frame follows `previous` by one step of `interval`
+    /// seconds, within `tolerance` seconds.
+    public func follows(_ previous: RenderedFrame, interval: Double, tolerance: Double = 0.001) -> Bool {
+        index == previous.index + 1 && abs((seconds - previous.seconds) - interval) <= tolerance
+    }
+}
