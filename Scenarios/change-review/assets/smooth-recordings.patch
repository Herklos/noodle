+import AVFoundation
+import NoodletRuntime
+import XCTest
+@testable import NoodleApplet
+
+/// Films a square that moves at a constant speed and checks that the frames
+/// are evenly spaced, whether or not the window is visible.
+@MainActor
+final class RecordingSmoothnessTests: XCTestCase {
+    private let framesPerSecond = 30
+    private let duration: TimeInterval = 2
+    private let tolerance = 0.001
+
+    private var runner: WebRunner!
+    private var outputURL: URL!
+
+    override func setUp() async throws {
+        runner = WebRunner(noodlet: try Fixtures.noodlet("moving-square"))
+        runner.load()
+        try await Fixtures.waitUntilLoaded(runner)
+        outputURL = FileManager.default.temporaryDirectory
+            .appendingPathComponent("smoothness-\(UUID().uuidString)")
+            .appendingPathExtension("mov")
+    }
+
+    override func tearDown() async throws {
+        try? FileManager.default.removeItem(at: outputURL)
+        runner = nil
+    }
+
+    func testFramesAreEvenlySpacedWhenVisible() async throws {
+        try await assertEvenlySpaced(hidden: false)
+    }
+
+    func testFramesAreEvenlySpacedWhenHidden() async throws {
+        runner.hide()
+        try await assertEvenlySpaced(hidden: true)
+    }
+
+    func testRenderedFramesFollowEachOther() {
+        let interval = 1.0 / Double(framesPerSecond)
+        let first = RenderedFrame(index: 0, time: 0)
+        let second = RenderedFrame(index: 1, time: 1000 * interval)
+        let late = RenderedFrame(index: 2, time: 2000 * interval + 5)
+        XCTAssertTrue(second.follows(first, interval: interval, tolerance: tolerance))
+        XCTAssertFalse(late.follows(second, interval: interval, tolerance: tolerance))
+    }
+
+    private func assertEvenlySpaced(
+        hidden: Bool,
+        file: StaticString = #filePath,
+        line: UInt = #line
+    ) async throws {
+        var options = Recording.Options()
+        options.framesPerSecond = framesPerSecond
+        options.maximumDuration = duration
+        let recording = Recording(runner: runner, outputURL: outputURL, options: options)
+        try await recording.start()
+        while case .recording = recording.state {
+            try await Task.sleep(for: .milliseconds(50))
+        }
+        guard case .finished = recording.state else {
+            return XCTFail("recording did not finish: \(recording.state)", file: file, line: line)
+        }
+
+        let times = recording.frameTimes.map(\.seconds)
+        let expected = Int(duration * Double(framesPerSecond))
+        XCTAssertEqual(times.count, expected, "hidden: \(hidden)", file: file, line: line)
+
+        let interval = 1.0 / Double(framesPerSecond)
+        for (index, pair) in zip(times, times.dropFirst()).enumerated() {
+            let gap = pair.1 - pair.0
+            XCTAssertEqual(gap, interval, accuracy: tolerance,
+                           "frame \(index + 1) is \(gap) s after frame \(index)", file: file, line: line)
+        }
+
+        let asset = AVURLAsset(url: outputURL)
+        let movieDuration = try await asset.load(.duration).seconds
+        XCTAssertEqual(movieDuration, duration, accuracy: interval, file: file, line: line)
+    }
+}
