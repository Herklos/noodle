<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notifications of unread replies while away from the Hub. Exporting for the App Store makes it production. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Where Hubs leave word of those replies: Production in a release, where released Hubs write. CloudKit takes
	     a subscription there only from an app that pushes in production, so development builds use Development. -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>$(MOBILE_CLOUDKIT_ENVIRONMENT)</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.pdparchitect.noodle</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Replies notify as messages from their bot, with its picture. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<!-- Shared with the notification and share extensions, which reach the Hubs kept here. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.$(MOBILE_APP_BUNDLE_ID)</string>
	</array>
</dict>
</plist>
